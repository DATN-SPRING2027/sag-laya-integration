# Docker Compose 可直接使用内置默认值；仅在需要自定义时复制本文件为 .env。

# ── 端口 ───────────────────────────────────────────────
WEB_PORT=3002
API_PORT=8000
# 本机默认只监听回环地址；局域网/服务器部署改为 0.0.0.0。
BIND_ADDRESS=127.0.0.1

# ── 本地快速启动 ───────────────────────────────────────
SAG_ENVIRONMENT=dev
SAG_CORS_ORIGINS=http://localhost:3002
# continuum：经 Continuum BE SSO 登录；local/password 仅用于单独开发或迁移。
SAG_AUTH_MODE=continuum
# SAG user IDs allowed to change shared model settings; empty denies these operations.
SAG_MODEL_CONFIG_OPERATOR_IDS=
# 仅 password 模式生效；false 仍允许建立首个正式凭据，之后禁止继续注册。
SAG_ALLOW_REGISTRATION=false
SAG_SAG_LANGUAGE=en

# 生产部署必须设置强随机值（生成命令：openssl rand -hex 32）。
# 本地 dev 留空时，Compose 会使用只适合本机的开发密钥。
SAG_SECRET_KEY=

# Shared with Continuum BE only; required for BE SSO login and project-scoped BFF calls.
# Use the same random value in BE's SAG_BFF_SERVICE_TOKEN (at least 32 characters).
SAG_BFF_SERVICE_TOKEN=

# ── Dify 外部知识库（可选）────────────────────────────
# 仅在需要接入 Dify 时执行 `make setup-dify` 自动生成；不要提交真实密钥。
SAG_DIFY_API_KEY=
# Dify 专用检索策略：vector（默认，低延迟）或 multi（实体扩展 + LLM 精排，延迟更高）。
SAG_DIFY_SEARCH_STRATEGY=vector

# 浏览器访问后端的地址（构建期内联；修改后需重建 web 镜像）。
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_CONTINUUM_SSO_URL=http://localhost:3000/api/backend/ai-engine/auth/sag-login
# Web 默认开启页内窗口缩放；桌面客户端构建时设为 false。
NEXT_PUBLIC_ENABLE_WINDOW_SCALING=true

# ── LLM / Embedding（也可启动后在设置页填写）──
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.302ai.cn/v1
SAG_LLM_API_KEY=
SAG_LLM_MODEL=qwen3.6-flash
SAG_LLM_MAX_TOKENS=20000
# auto 首选 json_schema，仅在网关明确不支持时缓存降级为 json_object。
SAG_LLM_STRUCTURED_OUTPUT_MODE=auto
# 上述 SAG_LLM_* 是首次启动的默认值；之后可在设置页调整并立即生效。
# 若部署方需要固定生成模型配置，设为 true。修改 LLM 配置后需重启服务。
SAG_LOCK_LLM_CONFIG=false
# Anthropic / Gemini 原生接入时将 SAG_LLM_PROVIDER 改为对应值，Base URL 留空使用官方端点。

# ── Decision Router（Kev-4B via SiliconFlow）──────────────────────────
SAG_DECISION_PROVIDER=siliconflow
SAG_DECISION_MODEL=Kev-4b
SAG_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SAG_SILICONFLOW_API_KEY=

# Session Context Engine (Zero-Mem + ECCE): off (default) | shadow | on
SAG_SESSION_CONTEXT_MODE=off
SAG_SESSION_CONTEXT_SCOPE=thread
SAG_SESSION_CONTEXT_EMBEDDING_MODE=zero_cost_local
SAG_SESSION_CONTEXT_PERSISTENCE_ENABLED=true
SAG_SESSION_CONTEXT_QDRANT_SYNC_ENABLED=true

SAG_EMBEDDING_MODEL=bge-large-en-v1.5
SAG_EMBEDDING_BASE_URL=https://api.302ai.cn/v1
SAG_EMBEDDING_API_KEY=

# 向量维度（须与模型一致，如 Qwen3-Embedding-8B = 4096）；留空使用默认 1024。
SAG_EMBEDDING_DIMENSIONS=

# ── 文档解析（Smart Hybrid MinerU Option A；未配置或失败时自动回退本地隔离子进程）────
SAG_DOCUMENT_PARSER=auto
# 302 使用下方默认地址；official 使用 https://mineru.net 与官方 API Token。
SAG_MINERU_PROVIDER=official
SAG_MINERU_BASE_URL=https://mineru.net
SAG_MINERU_OFFICIAL_MODEL=vlm
SAG_MINERU_PARSE_METHOD=auto
SAG_MINERU_OFFICIAL_API_TOKEN=
# ── R2 对象流式拉取与三车道解析隔离配置 ──────────────────
SAG_OBJECT_INGEST_ALLOWED_HOSTS=.r2.cloudflarestorage.com
SAG_OBJECT_INGEST_ALLOW_PRIVATE_HOSTS_IN_DEV=false
SAG_OBJECT_INGEST_TIMEOUT_SECONDS=120
SAG_LOCAL_PARSE_WORKERS=2
SAG_LOCAL_PARSE_TIMEOUT_SECONDS=90
SAG_LOCAL_PARSE_MAX_TASKS_PER_CHILD=25
SAG_MINERU_IO_CONCURRENCY=16
SAG_FAST_PARSE_CONCURRENCY=16
SAG_PER_PROJECT_HEAVY_PARSE_LIMIT=3
SAG_EXCEL_MAX_ROWS_PER_SHEET=5000
SAG_EXCEL_MAX_COLS_PER_SHEET=64
SAG_REMOTE_SNAPSHOT_GC_ENABLED=true

# ── Postgres 生产覆盖（compose.postgres.yaml）───────────
POSTGRES_USER=sag
# 生产覆盖必填；建议使用：openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=sag
QDRANT_PORT=6333
# Qdrant Cloud endpoint/API key used by Docker API. Leave URL empty to use the
# local qdrant service at http://qdrant:6333 instead.
SAG_SAG_QDRANT_URL=
SAG_SAG_QDRANT_API_KEY=
# Optional API key for the local qdrant fallback service.
QDRANT_API_KEY=

# ── 稳定性（可选，取消注释后生效）──────────────────────
# SAG_JOB_MAX_ATTEMPTS=3
# SAG_ENGINE_CACHE_SIZE=16
# SAG_ENGINE_WARMUP_COUNT=4
# SAG_MINERU_POLL_TIMEOUT=300

# Knowledge FOUNDATION (deterministic E0/E1 + DenseGraph + Leiden routing tree) runs independently after SEARCH_READY.
# Phase 5B E2 LLM enrichment was removed per docs/adr-remove-e2-llm-enrichment.md.
SAG_KNOWLEDGE_WORKER_ENABLED=true
SAG_KNOWLEDGE_CONCURRENCY=4
SAG_KNOWLEDGE_QUEUE_CAPACITY=256
# Graph/routing CPU runs in a killable spawned process; one admitted operation per API event loop.
SAG_KNOWLEDGE_GRAPH_TIMEOUT_SECONDS=300
SAG_EMBEDDING_MAX_RETRIES=3
# FOUNDATION timeout is derived from embedding timeout/retries + admission + commit margin.
# Set SAG_KNOWLEDGE_FOUNDATION_TIMEOUT_SECONDS only to explicitly override that envelope.

# Canonical upload/search does not run per-chunk Event/Entity LLM extraction.
SAG_DOCUMENT_EVENT_EXTRACTION_ENABLED=false
