  "discrepancy_root_cause": {
    "affected_fields": [
      "f2-f3-independent-validation.semantic-review.jsonl::raw_gold_evidence_recall",
      "f2-f3-independent-validation.summary.json::paired_results[*].raw_gold_evidence_recall",
      "f2-f3-independent-validation.summary.json::gate_matrix.normal_raw_gold_evidence_recall",
      "f2-f3-independent-validation.summary.json::gate_matrix.normal_fitted_gold_evidence_recall"
    ],
    "explanation": "scripts/verify_session_runtime.py stored candidate raw_selected_evidence as dicts with keys {'message_id', 'kind', 'text'}. The one-off summary generator read x.get('quote', '') instead of x['text'] when computing per-row raw_gold_evidence_recall, producing 0.0 for all 20 normal runtime rows while hardcoding observed=1.0 in gate_matrix.normal_raw_gold_evidence_recall. Additionally, fitted_evidence_messages in v2 was captured from plan.messages before memory.fit rather than from SessionContext.dispatched_evidence_messages at BudgetedLLM._create_completion."
  },
  "metric_definitions": {
    "raw_gold_evidence_recall": {
      "formula": "count(gold_items where all required evidence entries match an item in raw_selected_evidence with entry.message_id == expanded_messages[ev.at].id, entry.kind == f'{expanded_messages[ev.at].role}_statement', and ev.quote in entry.text) / count(gold_items with evidence)",
      "recomputed_row_count": 20,
      "recomputed_row_min": 1.0,
      "recomputed_row_mean": 1.0,
      "total_covered_gold_items": 38,
      "total_gold_items": 38,
      "status": "PROVEN_FROM_V2_RAW_SELECTED_EVIDENCE"
    },
    "pre_fit_gold_evidence_recall": {
      "formula": "count(gold_items where all required evidence entries match an item parsed from pre-fit SESSION_EVIDENCE_JSON in plan.messages with entry.message_id == expanded_messages[ev.at].id, entry.kind == f'{expanded_messages[ev.at].role}_statement', and ev.quote in entry.text) / count(gold_items with evidence)",
      "recomputed_row_count": 20,
      "recomputed_row_min": 1.0,
      "recomputed_row_mean": 1.0,
      "total_covered_gold_items": 38,
      "total_gold_items": 38,
      "status": "PROVEN_PRE_FIT_ONLY"
    },
    "fitted_gold_evidence_recall_post_memory_fit": {
      "formula": "count(gold_items where all required evidence entries match an item parsed from SessionContext.dispatched_evidence_messages captured at BudgetedLLM._create_completion after memory.fit) / count(gold_items with evidence)",
      "observed": null,
      "status": "NOT PROVEN",
      "reason": "Historical v2 artifact captured plan.messages prior to agent_service.generate_stream -> memory.fit -> SessionContext.note_dispatch. Post-fit prompt capture is now implemented in SessionContext.note_dispatch and verify_session_runtime.py for future runs."
    }
